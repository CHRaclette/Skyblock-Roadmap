DISCORD_TOKEN=dein-neuer-bot-token
PORT=3000
SKYHELPER_API_URL=https://api.altpapier.dev

# --- Roadmap ---
# Port der Roadmap-Seite (nur Lesen, darf öffentlich sein)
ROADMAP_PORT=3001
# --- GitHub Pages (empfohlen, fester Link) ---
# Repository mit der Roadmap-Website, z. B. relaxogx/skyblock-roadmap
GITHUB_REPO=CHRaclette/Skyblock-Roadmap
# Fine-grained Token nur für dieses Repo, Berechtigung "Actions: Read and write"
GITHUB_TOKEN=
# Optional: Workflow-Datei und Branch
GITHUB_WORKFLOW=pages.yml
GITHUB_BRANCH=main

# Fester öffentlicher Link, falls ihr eine eigene Domain habt, z. B. https://roadmap.example.ch
# Leer lassen: GitHub Pages (falls GITHUB_REPO gesetzt), sonst Cloudflare-Tunnel, sonst die Seite als Datei.
PUBLIC_URL=
# Kanal-ID, in den das tägliche Update gepostet wird (optional)
ROADMAP_CHANNEL_ID=
# Stunde (Europe/Zurich), ab der das tägliche Update läuft
ROADMAP_UPDATE_HOUR=6
# Optional: erlaubt POST /api/roadmap/update mit Header x-update-token
ROADMAP_UPDATE_TOKEN=
